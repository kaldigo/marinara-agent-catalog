{
  "schemaVersion": 1,
  "type": "capability-package",
  "includeInMain": true,
  "processing": {
    "kind": "package-build",
    "buildCommand": ["npm", "run", "build"],
    "outputDir": "dist/package",
    "sharedRoots": ["_mari-bridge"]
  },
  "package": {
    "id": "mari-bridge",
    "name": "Mari Bridge",
    "description": "Shared patch host, health gate, and runtime SDK service for Marinara capability packages.",
    "engine": {
      "min": "2.4.3",
      "maxExclusive": "2.4.4"
    },
    "kind": ["agent"],
    "permissions": ["agent-runtime", "prompt-context", "routes", "storage", "ui"],
    "restartRequired": true
  }
}
