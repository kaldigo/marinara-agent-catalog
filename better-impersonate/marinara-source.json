{
  "schemaVersion": 1,
  "type": "capability-package",
  "includeInMain": true,
  "processing": {
    "kind": "package-build",
    "buildCommand": [
      "npm",
      "run",
      "build"
    ],
    "outputDir": "dist/package"
  },
  "package": {
    "id": "better-impersonate",
    "name": "Better Impersonate",
    "description": "Native Quick Actions for impersonation drafts, continuation and guidance recall.",
    "engine": {
      "min": "2.5.0",
      "maxExclusive": "2.5.1"
    },
    "kind": [
      "agent"
    ],
    "permissions": [
      "storage",
      "ui"
    ],
    "restartRequired": false
  }
}
