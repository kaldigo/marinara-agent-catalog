{
  "schemaVersion": 1,
  "type": "capability-package",
  "includeInMain": true,
  "processing": {
    "kind": "package-build",
    "buildCommand": ["npm", "run", "build"],
    "outputDir": "dist/package",
    "sharedRoots": ["_mari-bridge"]
  },
  "package": {
    "id": "presence",
    "name": "Presence",
    "description": "Per-message character presence for Roleplay chats.",
    "engine": {
      "min": "2.4.4",
      "maxExclusive": "2.4.5"
    },
    "kind": ["agent"],
    "permissions": ["agent-runtime", "chat-read", "chat-write", "routes", "ui"],
    "restartRequired": true
  }
}
