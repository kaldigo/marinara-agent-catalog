{
  "schemaVersion": 1,
  "type": "capability-package",
  "includeInMain": true,
  "processing": {
    "kind": "package-build",
    "buildCommand": ["npm", "run", "build"],
    "outputDir": "dist/package",
    "sharedRoots": ["_mari-bridge"]
  },
  "package": {
    "id": "group-sort-order",
    "name": "Group Sort Order",
    "description": "Tracks and displays the next character or persona using Marinara's native generation and composer flow.",
    "engine": {
      "min": "2.4.4",
      "maxExclusive": "2.4.5"
    },
    "kind": ["agent"],
    "permissions": ["agent-runtime", "chat-read", "chat-write", "prompt-context"],
    "restartRequired": true
  }
}
