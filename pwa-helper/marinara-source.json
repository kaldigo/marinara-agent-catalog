{
  "schemaVersion": 1,
  "type": "capability-package",
  "includeInMain": true,
  "processing": {
    "kind": "package-build",
    "buildCommand": ["npm", "run", "build"],
    "outputDir": "dist/package",
    "sharedRoots": ["_mari-bridge"]
  },
  "package": {
    "id": "pwa-helper",
    "name": "PWA Helper",
    "description": "Keeps mobile and tablet screens awake while Marinara generation is running and improves iOS home-screen metadata.",
    "engine": {
      "min": "2.4.4",
      "maxExclusive": "2.4.5"
    },
    "kind": ["agent"],
    "permissions": ["ui"],
    "restartRequired": false
  }
}
