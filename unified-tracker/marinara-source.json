{
  "schemaVersion": 1,
  "type": "capability-package",
  "includeInMain": true,
  "processing": {
    "kind": "package-build",
    "buildCommand": ["npm", "run", "build"],
    "outputDir": "dist/package",
    "sharedRoots": ["_mari-bridge", "_tracker-codecs"]
  },
  "package": {
    "id": "unified-tracker",
    "name": "Unified Tracker",
    "version": "1.0.0",
    "description": "Combines enabled tracker sections into one structured parallel agent while preserving native tracker storage, locks, history, and UI surfaces.",
    "engine": {
      "min": "2.4.4",
      "maxExclusive": "2.4.5"
    },
    "kind": ["agent"],
    "permissions": ["agent-runtime", "chat-read", "chat-write", "prompt-context", "storage", "ui"],
    "restartRequired": true
  }
}
