{
  "schemaVersion": 1,
  "type": "capability-package",
  "includeInMain": true,
  "processing": {
    "kind": "package-build",
    "buildCommand": ["npm", "run", "build"],
    "outputDir": "dist/package",
    "sharedRoots": ["_mari-bridge"]
  },
  "package": {
    "id": "better-impersonate",
    "name": "Better Impersonate",
    "description": "Adds slash commands for persona draft generation through system Quick Replies with {{input}}.",
    "engine": {
      "min": "2.4.4",
      "maxExclusive": "2.4.5"
    },
    "kind": ["agent"],
    "permissions": ["storage", "ui"],
    "restartRequired": false
  }
}
